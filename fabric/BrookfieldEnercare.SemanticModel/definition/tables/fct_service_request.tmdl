/// All open and in-progress service requests enriched with SLA status, customer context, and equipment type. Primary operational dashboard for dispatch and service coordination.
table fct_service_request
	lineageTag: 82a63417-6d59-4b67-81fc-0dcc3763236a
	sourceLineageTag: [dbo].[fct_service_request]

	measure 'Technician Utilization Rate' = DIVIDE(DISTINCTCOUNT(fct_service_request[TechnicianId]), COUNTROWS(fct_service_request))
		formatString: 0.0%

		annotation SourceObject_References = dbo.vw_technician_utilization_summary

		annotation KeyResult_Id = KR-TECH-UTIL

		annotation Governance_Request_Id = SEMPROMO-TECHUTIL-001

	/// Unique service request identifier
	column RequestKey
		dataType: int64
		formatString: 0
		lineageTag: 9cf25cc1-5747-4745-a168-7eb601e1b163
		sourceLineageTag: RequestKey
		summarizeBy: count
		sourceColumn: RequestKey

		annotation SummarizationSetBy = Automatic

	column ServiceAccountKey
		dataType: int64
		formatString: 0
		lineageTag: 35d43064-02af-4342-9172-fd47735270b1
		sourceLineageTag: ServiceAccountKey
		summarizeBy: count
		sourceColumn: ServiceAccountKey

		annotation SummarizationSetBy = Automatic

