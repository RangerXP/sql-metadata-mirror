		summarizeBy: count
		sourceColumn: CreatedDateKey

		annotation SummarizationSetBy = Automatic

	column ScheduledDateKey
		dataType: int64
		formatString: 0
		lineageTag: 601973ab-2293-4d57-9628-6b64d8a2e85c
